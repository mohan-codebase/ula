---
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import {routes} from '../../data/explore';
---
<Base title="Trips in Tamil Nadu" description="Explore two and four-day Tamil Nadu trips, compare suggested itineraries and create your own personal travel brief.">
<PageHeading label="A FEW DAYS. A DIFFERENT PERSPECTIVE." title="Find your next trip." description="A coastal weekend, a slower hill escape or a journey from temple streets to island roads. Start with an idea, then make it yours."/>
<section class="trip-collection wrap" aria-label="Suggested Tamil Nadu trips">{routes.map((r,i)=><article class="trip-feature"><a class="story-photo" href={`/trips/${r.slug}/`}><Photo src={r.image} sizes="(max-width:700px) 100vw, 55vw" loading={i===0?'eager':'lazy'}/></a><div class="trip-feature-copy"><span class="meta">{r.tag} · {r.days} days</span><h2><a href={`/trips/${r.slug}/`}>{r.name}</a></h2><p>{r.summary}</p><p class="trip-path">{r.route}</p><div class="trip-actions"><a class="text-link" href={`/trips/${r.slug}/`}>View itinerary </a><button class="button" data-plan data-plan-destination={r.destination} data-plan-route={r.slug}><span>Plan this trip</span></button></div></div></article>)}</section>
<section class="planning-notes wrap"><h2>Your dates.<br/>Your own pace.</h2><div><p>These are independent travel suggestions. Use the planner to save a personal brief, then arrange transport and accommodation with your chosen providers.</p><a class="text-link" href="/travel-guide/">Read the travel guide</a></div></section>
</Base>
