---
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import {stories} from '../../data/journal';
---
<Base title="The journal" description="Tamil Nadu travel notes on Madurai mornings, slower Nilgiri days and the stonework of Mamallapuram.">
<PageHeading label="THE ULA JOURNAL" title="A place.<br/>A little perspective." description="Read a little before you go. Notes on the details, detours and slower moments that can shape a journey."/>
<section class="journal-collection wrap" aria-label="Travel stories">{stories.map((s,i)=><article class:list={['journal-entry',{'journal-entry-featured':i===0}]}><a class="story-photo" href={`/journal/${s.slug}/`}><Photo src={s.image} sizes="(max-width:700px) 100vw, 55vw" loading={i===0?'eager':'lazy'}/></a><div><span class="meta">{s.category} · {s.read}</span><h2><a href={`/journal/${s.slug}/`}>{s.title}</a></h2><p>{s.excerpt}</p><a class="text-link" href={`/journal/${s.slug}/`}>Read the story</a></div></article>)}</section>
</Base>
