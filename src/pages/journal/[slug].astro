---
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import {stories} from '../../data/journal';
export function getStaticPaths(){return stories.filter(s=>s.sections).map(story=>({params:{slug:story.slug},props:{story}}));}
const {story:s}=Astro.props;
const next=stories[(stories.findIndex(x=>x.slug===s.slug)+1)%stories.length];
---
<Base title={s.title} description={s.excerpt}>
<article class="journal-article"><header class="wrap article-heading"><a href="/journal/" class="text-link">← The journal</a><span class="meta">{s.category} · {s.read}</span><h1>{s.title}</h1><p>{s.excerpt}</p></header><Photo src={s.image} sizes="100vw" class="article-image" loading="eager" fetchpriority="high"/><div class="article-body">{s.sections?.map(section=><section><h2>{section.title}</h2><p>{section.text}</p></section>)}<a class="text-link" href={`/journeys/${s.destination}/`}>Explore the destination</a><p class="demo-note">An editorial route suggestion, not a firsthand travel report. Destination background: <a href={s.source}>official tourism information</a>.</p><a class="next-story" href={`/journal/${next.slug}/`}><span class="meta">READ ANOTHER STORY</span><h2>{next.title} </h2></a></div></article>
</Base>
