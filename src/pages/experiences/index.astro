---
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import {experiences} from '../../data/explore';
---
<Base title="Experiences" description="Explore Tamil Nadu through temple heritage, slow hill days and coastal journeys.">
<PageHeading label="WAYS TO WANDER" title="Follow a feeling." description="Start with the kind of day you want. A carved stone, a quiet hill road, a horizon that keeps opening up."/><div class="experience-stories wrap">{experiences.map((e,i)=><article class:list={['experience-story',{'is-reverse':i%2===1}]}><a class="story-photo" href={`/experiences/${e.id}/`}><Photo src={e.image} sizes="(max-width:700px) 100vw, 55vw" loading={i===0?'eager':'lazy'}/></a><div><span class="meta">{e.label}</span><h2><a href={`/experiences/${e.id}/`}>{e.title}</a></h2><p>{e.description}</p><a class="text-link" href={`/experiences/${e.id}/`}>Explore this experience </a></div></article>)}</div>
</Base>
