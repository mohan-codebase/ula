---
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import PageHeading from '../../components/PageHeading.astro';
import {experiences,routes} from '../../data/explore';
import {journeys} from '../../data/site';
export function getStaticPaths(){return experiences.map(experience=>({params:{slug:experience.id},props:{experience}}));}
const {experience:e}=Astro.props;
const places=journeys.filter(j=>e.places.some(p=>p.slug===j.slug));
const related=routes.filter(r=>places.some(j=>r.places.includes(j.slug)));
---
<Base title={e.label} description={e.description}>
<PageHeading label={e.label} title={e.title} description={e.description}/>
<figure class="experience-panorama wrap"><Photo src={e.image} sizes="100vw" loading="eager" fetchpriority="high"/><figcaption>{e.note}</figcaption></figure>
<section class="experience-places wrap"><div class="section-heading"><h2>Places to begin.</h2><a class="text-link" href="/experiences/">All experiences</a></div><div class="place-index">{places.map(j=><a href={`/journeys/${j.slug}/`}><Photo src={j.image.replace('.webp','-small.webp')} sizes="(max-width:700px) 25vw, 20vw" loading="lazy"/><div><span class="meta">{j.category}</span><h3>{j.name}</h3><p>{j.note}</p></div></a>)}</div></section>
<section class="related-routes wrap"><h2>Give the feeling a route.</h2>{related.map(r=><a class="related-route" href={`/trips/${r.slug}/`}><span>{r.days} days</span><h3>{r.name}</h3></a>)}</section>
</Base>
