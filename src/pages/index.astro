---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import {photography} from '../data/photography';
import DestinationCollection from '../components/DestinationCollection.astro';
import {journeys,article} from '../data/site';
import {bannerSlides} from '../data/banner';
import Experiences from '../components/Experiences.astro';
import SuggestedRoutes from '../components/SuggestedRoutes.astro';
import SeasonGuide from '../components/SeasonGuide.astro';
import Culture from '../components/Culture.astro';
import TravelFaq from '../components/TravelFaq.astro';
---
<Base>
<section class="hero" aria-label="Tamil Nadu highlights" aria-roledescription="carousel">
<div class="hero-scenes">{bannerSlides.map(({place:j},i)=><picture class="responsive-photo">{i===0&&<source type="image/avif" srcset={`${j.image.replace('.webp','-small.avif')} 800w, ${j.image.replace('.webp','.avif')} 1600w, ${j.image.replace('.webp','-large.avif')} 2400w`} sizes="100vw"/>}<img class:list={['hero-scene',{'is-current':i===0}]} data-scene={j.slug} data-scene-src={i>0?j.image:undefined} data-scene-srcset={i>0?`${j.image.replace('.webp','-small.webp')} 800w, ${j.image} 1600w, ${j.image.replace('.webp','-large.webp')} 2400w`:undefined} src={i===0?j.image:'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs='} srcset={i===0?`${j.image.replace('.webp','-small.webp')} 800w, ${j.image} 1600w, ${j.image.replace('.webp','-large.webp')} 2400w`:undefined} sizes="100vw" alt={j.alt} width="1600" height="1067" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'low'} decoding="async" style={`object-position:${photography[j.slug].position}`}/></picture>)}</div><div class="hero-scrim"></div><span class="sr-only" role="status" data-scene-status></span>
<div class="hero-content"><div class="hero-label" data-banner-label>{bannerSlides[0].label}</div><h1 data-banner-title>Tamil Nadu.<br/>A world of<br/><span>wonder.</span></h1><div class="hero-intro"><p data-banner-description>From temple streets to the Nilgiri hills.<br/>Find a journey that feels like you.</p><a class="button button-accent" data-banner-action href="#destinations"><span>Explore Tamil Nadu</span></a></div></div>

<div class="scene-field-note"><span class="meta">A PAGE FROM THE JOURNEY</span><p data-scene-observation>{journeys[0].fieldNote}</p></div><div class="hero-bottom"><a class="scene-note" href="/journeys/madurai/" data-scene-link><span class="pin" aria-hidden="true">⌖</span><span><span class="meta">A LITTLE INSPIRATION</span><strong data-scene-name>Madurai, Tamil Nadu</strong></span></a><div class="scene-tabs" role="group" aria-label="Choose a landscape">{bannerSlides.map(({place:j},i)=><button data-destination={j.slug} aria-pressed={i===0}><span class="tab-number">0{i+1}</span><span>{j.name}</span></button>)}</div></div>
<div class="banner-controls"><span data-banner-count aria-label="Slide 1 of 4">01 / 04</span><button type="button" data-banner-prev aria-label="Previous banner slide">Previous</button><button type="button" data-banner-next aria-label="Next banner slide">Next</button><button type="button" data-banner-pause aria-label="Pause banner slideshow">Pause</button></div>
</section>
<section class="intro-section wrap"><div class="intro-label"><svg viewBox="0 0 70 70" aria-hidden="true"><path d="M9 15q14-7 26 0 14-7 26 0v42q-14-7-26 0-14-7-26 0zM35 15v42M16 25q7-3 12 0m-12 9q7-3 12 0m14-9q7-3 12 0m-12 9q7-3 12 0" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>SIX WAYS TO<br/>FIND YOUR TAMIL NADU</span></div><div><h2>Ancient stories. Fresh air.<br/>Places that <span class="underline-sketch">move you.</span></h2><div class="intro-copy"><p>The painted towers of Madurai. The mountain air around Ooty. A stone temple beside the sea in Mamallapuram. Tamil Nadu has a different rhythm waiting around every turn.</p><p>Choose a temple town, a hill escape or a few days on the coast. Explore our suggested local routes, then create a personal trip brief with room for the places that interest you most.</p></div></div></section>
<DestinationCollection />
<Experiences />
<SuggestedRoutes />
<section class="approach" id="approach"><div class="wrap approach-grid"><div class="approach-statement"><span class="meta">LESS CHECKLIST. MORE CONNECTION.</span><h2>Collect moments.<br/>Not just<br/><span>destinations.</span></h2><p>Some of the best things happen<br/>between the things you planned.</p></div><div class="approach-steps"><div><span>01</span><section><h3>Go where you're curious.</h3><p>Start with what draws you in: temple architecture, a mountain morning, a coastal drive or a taste of local food.</p></section></div><div><span>02</span><section><h3>Leave a little space.</h3><p>Choose a region and give it time. Keep room for a filter coffee, a market walk or an extra stop along the coast.</p></section></div><div><span>03</span><section><h3>Make the journey yours.</h3><p>Take our routes as a starting point. Adapt the pace, follow a recommendation, stay an extra day.</p></section></div><button class="button button-accent" data-plan><span>Start with a little daydream</span></button></div></div></section>
<SeasonGuide />
<Culture />
<section class="journal-section wrap"><a class="journal-image" href="/journal/a-morning-in-madurai/"><Photo src="/images/madurai.webp" sizes="(max-width:700px) 100vw, 50vw"/><span class="journal-sticker" aria-hidden="true">Notes<br/>from<br/>Madurai</span></a><div class="journal-copy"><span class="meta">THE JOURNAL · A MOMENT TO READ</span><h2>{article.title}</h2><p>{article.description} A field note on flower stalls, palace courtyards and finding a little time between the landmarks.</p><a class="text-link" href="/journal/a-morning-in-madurai/"><span>Read the story</span></a><span class="read-time">3 MIN READ</span></div></section>
<TravelFaq />
</Base>
