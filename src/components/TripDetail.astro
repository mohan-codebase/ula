---
import Photo from './Photo.astro';
import Base from '../layouts/Base.astro';
import {routes} from '../data/explore';
import {journeys} from '../data/site';
import {tripDetails} from '../data/trip-details';
import '../styles/trip-details.css';
const r=Astro.props.route as (typeof routes)[number];
const d=tripDetails[r.slug];
const places=journeys.filter(j=>r.places.includes(j.slug));
const next=routes[(routes.findIndex(route=>route.slug===r.slug)+1)%routes.length];
const sections=[['overview','Overview'],['itinerary','Daily itinerary'],['practical','Travel & stays'],['food','Food & budget'],['before-you-go','Before you go'],['trip-questions','FAQs']];
---
<Base title={`${r.name}: detailed ${r.days}-day trip`} description={`Plan ${r.days} days in Tamil Nadu: ${r.route}. Detailed daily itinerary, stays, transport, food, packing advice and FAQs.`} canonicalPath={`/trips/${r.slug}/`}>
<header class="route-detail-heading wrap"><a class="text-link" href="/trips/">← All trips</a><div class="route-detail-title"><span class="meta">{r.tag} · TAMIL NADU</span><h1>{r.name}</h1><div><p>{r.summary}</p><span class="route-days">{r.days} DAYS · YOUR OWN PACE</span></div></div><div class="route-detail-meta"><span>{r.route}</span><button class="text-link" data-plan data-plan-destination={r.destination} data-plan-route={r.slug}>Use this route</button></div></header>
<div class="detail-photo route-detail-photo"><Photo src={r.image} sizes="100vw" loading="eager" fetchpriority="high"/><span>{d.stay.toUpperCase()}</span></div>
<nav class="trip-section-nav" aria-label="Trip sections"><div class="wrap">{sections.map(([id,label])=><a href={`#${id}`}>{label}</a>)}</div></nav>
<div class="trip-detail-layout wrap"><div class="trip-main">
<section id="overview" class="trip-section"><span class="meta">THE JOURNEY AT A GLANCE</span><h2>A little structure.<br/>Plenty to discover.</h2><p class="trip-lead">{d.intro}</p><dl class="trip-facts"><div><dt>Starts in</dt><dd>{d.start}</dd></div><div><dt>Finishes in</dt><dd>{d.finish}</dd></div><div><dt>Suggested stay</dt><dd>{d.stay}</dd></div><div><dt>The pace</dt><dd>{d.pace}</dd></div></dl><div class="trip-highlights"><h3>What to look forward to</h3><ul>{d.highlights.map(h=><li>{h}</li>)}</ul></div><div class="trip-route-strip" aria-label="Route stops">{r.route.split(' · ').map((place,i)=><><span>{place}</span>{i<r.route.split(' · ').length-1&&<span aria-hidden="true">→</span>}</>)}</div></section>
<section id="itinerary" class="trip-section"><div class="trip-section-heading"><span class="meta">DAY BY DAY</span><h2>Your days,<br/>in a little more detail.</h2><p>Use these as flexible parts of a day, rather than fixed appointment times.</p></div><nav class="trip-day-links" aria-label="Choose an itinerary day">{d.days.map((_,i)=><a href={`#day-${i+1}`}>Day {i+1}<span aria-hidden="true">↓</span></a>)}</nav><div class="trip-days">{d.days.map((day,i)=><article class="trip-day" id={`day-${i+1}`}><div class="trip-day-heading"><span class="trip-day-number">{String(i+1).padStart(2,'0')}</span><div><span class="meta">DAY {i+1} · {day.overnight==='Onward journey'?'DEPARTURE':`STAY IN ${day.overnight.toUpperCase()}`}</span><h3>{day.title}</h3><p>{day.summary}</p></div></div><div class="trip-day-blocks">{day.blocks.map(block=><section><span class="trip-time">{block.time}</span><div><h4>{block.title}</h4><p>{block.text}</p></div></section>)}</div><div class="trip-day-note"><span class="meta">LEAVE ROOM FOR THIS</span><p>{day.note}</p></div><details class="trip-alternative"><summary>An alternative for this day <span aria-hidden="true">+</span></summary><p>{day.alternative}</p></details></article>)}</div></section>
<section id="practical" class="trip-section"><span class="meta">THE PRACTICAL PART</span><h2>Getting there.<br/>Feeling settled.</h2><div class="trip-editorial-list"><h3>Travel & local transport</h3>{d.transport.map(item=><article><h4>{item.title}</h4><p>{item.text}</p></article>)}</div><div class="trip-editorial-list"><h3>Where to base yourself</h3>{d.stays.map(item=><article><h4>{item.title}</h4><p>{item.text}</p></article>)}</div><p class="trip-small-note">Stay areas are planning suggestions, not hotel recommendations or availability listings. Arrange every booking directly with your chosen provider.</p></section>
<figure class="trip-interlude"><Photo src={`/images/${r.destination}-detail.webp`} sizes="(max-width:800px) 100vw, 65vw"/><figcaption>{r.slug==='nilgiri-reset'?'Still water and a slower Ooty afternoon.':r.slug==='temple-to-island'?'Look closer at the carved details of Madurai.':'The Shore Temple, seen through its surrounding stonework.'}</figcaption></figure>
<section id="food" class="trip-section"><span class="meta">GOOD MEALS. THOUGHTFUL CHOICES.</span><h2>Make room<br/>around the itinerary.</h2><div class="trip-editorial-list"><h3>Food & little pauses</h3>{d.food.map(item=><article><h4>{item.title}</h4><p>{item.text}</p></article>)}</div><div class="trip-editorial-list"><h3>Build your travel budget</h3>{d.budget.map(item=><article><h4>{item.title}</h4><p>{item.text}</p></article>)}</div></section>
<section id="before-you-go" class="trip-section"><span class="meta">A LITTLE PREPARATION</span><h2>Pack lightly.<br/>Plan with the place.</h2><div class="trip-editorial-list"><h3>Season & conditions</h3><p>{d.season}</p><a class="text-link" href="/travel-guide/">Read the seasonal guide</a></div><div class="trip-packing"><h3>Useful things to bring</h3><ul>{d.packing.map(item=><li>{item}</li>)}</ul></div><div class="trip-scope"><h3>What this trip page gives you</h3><p>A suggested route, a flexible daily plan, practical notes and a downloadable personal brief.</p><h3>What you arrange separately</h3><p>Transport, accommodation, meals, tickets, guides and any optional activity. Ula does not sell a package or make a reservation.</p></div></section>
<section id="trip-questions" class="trip-section"><span class="meta">BEFORE YOU MAKE IT YOURS</span><h2>A few trip questions.</h2><div class="faq-list trip-faq">{d.faqs.map(faq=><details><summary><h3>{faq.question}</h3><span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{faq.answer}</p></div></details>)}</div><div class="trip-sources"><h3>Useful official links</h3><p>Destination background comes from the sources below. Daily ordering, meal breaks and alternatives are Ula’s editorial suggestions. Check current services and visitor rules before travel.</p>{d.sources.map(source=><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>)}</div></section>
</div><aside class="trip-planning-aside"><div class="trip-plan-card"><span class="meta">YOUR NEXT CHAPTER</span><h2>Make this<br/>trip yours.</h2><p>{r.days} days of inspiration.<br/>{d.stay}.</p><dl><div><dt>Best for</dt><dd>{d.bestFor}</dd></div><div><dt>Travel style</dt><dd>Independent & flexible</dd></div></dl><button class="button" data-plan data-plan-destination={r.destination} data-plan-route={r.slug}><span>Make this route yours</span></button><p class="trip-small-note">Choose your date, travelers and pace. Download a brief to keep. Nothing is booked or sent.</p><div class="route-place-links"><span class="meta">GET TO KNOW THE PLACES</span>{places.map(j=><a href={`/journeys/${j.slug}/`}>{j.name}</a>)}</div></div></aside></div>
<section class="trip-final-cta wrap"><div><span class="meta">THE NEXT STEP IS YOURS</span><h2>A good plan leaves<br/>room for you.</h2></div><button class="button" data-plan data-plan-destination={r.destination} data-plan-route={r.slug}><span>Plan this trip</span></button></section>
<section class="next-journey next-route wrap"><span class="meta">ANOTHER WAY TO WANDER</span><a href={`/trips/${next.slug}/`}><h2>{next.name}</h2></a></section>
</Base>
