---
import Photo from './Photo.astro';
import {journeys} from '../data/site';
const {collection=false}=Astro.props;
---
<section class:list={["destinations wrap",{"collection-content":collection}]} id="destinations">{collection?<h2 class="sr-only">Destination collection</h2>:<div class="section-heading"><div><span class="meta">FOLLOW YOUR CURIOSITY</span><h2>Where will<br/>Tamil Nadu take you?</h2></div><p>Heritage, hills and the coast.<br/>A starting point for your next local escape.</p></div>}<div class="filter-row"><div class="filters" role="group" aria-label="Filter destinations">{['All places','Temple towns','Hills & nature','Coastal escapes'].map((filter,i)=><button data-filter={filter} aria-pressed={i===0}>{filter}{i===0&&<span>{String(journeys.length).padStart(2,'0')}</span>}</button>)}</div><span class="filter-caption" aria-live="polite" data-filter-count>{journeys.length} places to explore</span></div>
<div class="destination-grid">{journeys.map((j,i)=><article class:list={['destination-card',`card-${i}`]} data-category={j.category}><a class="destination-image" href={`/journeys/${j.slug}/`}><Photo src={j.image} sizes="(max-width: 700px) 100vw, 48vw" loading={collection&&i===0?'eager':'lazy'} fetchpriority={collection&&i===0?'high':'auto'}/><span class="image-tag">{j.category}</span><div class="image-caption"><span class="meta">{j.country}</span><h3>{j.name}</h3></div></a><div class="card-note"><div><h4>{j.label}</h4><p>{j.note}</p><span class="card-route">{j.route}</span></div><span>{j.days} days<br/><span>of possibility</span></span></div></article>)}</div></section>
