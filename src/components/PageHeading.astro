---
const {label,title,description}=Astro.props;
---
<header class="page-heading wrap"><a class="text-link" href="/">← Ula / Tamil Nadu</a><div class="page-heading-grid"><div><span class="meta">{label}</span><h1>{title.split('<br/>').map((line:string,i:number)=><>{i>0&&<br/>}{line}</>)}</h1></div><p>{description}</p></div></header>
