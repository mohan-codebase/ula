---
import {culturalNotes} from '../data/explore';
---
<section class="culture-section wrap" id="culture" aria-labelledby="culture-title"><div class="culture-visual"><img class="culture-coffee" src="/images/filter-coffee.webp" srcset="/images/filter-coffee-small.webp 800w, /images/filter-coffee.webp 1600w" sizes="(max-width:700px) 100vw, 45vw" alt="South Indian filter coffee served in a metal tumbler and davara" width="1000" height="1200" loading="lazy"/><div class="culture-art"><img src="/images/thanjavur-art-small.webp" alt="An example of the detailed Thanjavur painting tradition" width="500" height="650" loading="lazy"/><span>THANJAVUR, IN THE DETAILS</span></div><span class="culture-caption">The small things become the story.</span></div><div class="culture-copy"><span class="meta">A TASTE. A TEXTURE. A MEMORY.</span><h2 id="culture-title">Take a little<br/>Tamil Nadu<br/>with you.</h2>{culturalNotes.map(n=><div class="culture-note"><h3>{n.title}</h3><p>{n.text}</p><a class="text-link" href={n.href}>{n.link}</a></div>)}</div></section>
