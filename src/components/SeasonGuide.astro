---
import {months,seasons} from '../data/explore';
---
<section class="season-section" id="when-to-go" aria-labelledby="season-title"><div class="wrap season-layout"><div class="season-intro"><span class="meta">TIMING IS PART OF THE JOURNEY</span><h2 id="season-title">Find your<br/>season.</h2><p>Sea air, mountain mist, a city in the rain.<br/>Every month has its own rhythm.</p></div><div class="season-guide"><div class="month-options" role="group" aria-label="Choose your travel month">{months.map((m,i)=><button aria-label={m} aria-pressed={i===0} data-month={i}>{m.slice(0,3)}</button>)}</div><div class="season-content" aria-live="polite" aria-atomic="true">{seasons.map((s,i)=><div data-season-panel={s.id} hidden={i!==0}><span class="season-range">{s.range}</span><h3>{s.title}</h3><p>{s.description}</p><div class="season-places">{s.places.map(p=><a href={`/journeys/${p.slug}/`}>{p.name}</a>)}</div><p class="season-tip">{s.tip}</p></div>)}</div><p class="season-source">Typical seasonal patterns. For current conditions, visit <a href="https://mausam.imd.gov.in/chennai/" target="_blank" rel="noopener noreferrer">IMD Chennai</a>.</p></div></div></section>
